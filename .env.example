# Répertoire des données Claude Code sur la machine hôte
# macOS : CLAUDE_CONFIG_DIR=~/Library/Application Support/Claude
# Linux : CLAUDE_CONFIG_DIR=~/.claude
# Windows : CLAUDE_CONFIG_DIR=%APPDATA%/Claude
CLAUDE_CONFIG_DIR=~/.claude

# Plan Claude (pro, max_5x, max_20x)
CLAUDE_PLAN=pro

# Limites personnalisées (optionnel, override les presets)
SESSION_LIMIT_USD=3.50
WEEKLY_LIMIT_USD=35.00

# Cache
CACHE_TTL_SECONDS=60

# Reset hebdomadaire (jour de la semaine: 0=lundi, 5=samedi, 6=dimanche)
WEEKLY_RESET_DAY=0
WEEKLY_RESET_HOUR=0

# Auth (optionnel)
API_KEY=

# Serveur
HOST=0.0.0.0
PORT=8080
